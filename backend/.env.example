# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ashwa-india

# JWT Configuration
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES=30d

# Uploads — canonical storage root (files are saved flat, directly under this folder).
# Leave both unset to use the built-in default: NODE_ENV=development -> backend/uploads,
# NODE_ENV=production -> /var/www/uploads. Set UPLOAD_DIR to override either way.
# UPLOAD_DIR=
# UPLOAD_PATH=

# Image storage provider: local disk (above) or Cloudinary. Also toggleable live
# from Admin > Developer Settings — that DB setting takes precedence once set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP (used by everyone except Admin, who logs in with email+password)
USE_DEFAULT_OTP=true
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=600

# SMS India Hub (only used when USE_DEFAULT_OTP=false)
SMS_INDIA_HUB_USERNAME=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
